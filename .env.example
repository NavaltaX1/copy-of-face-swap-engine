# Copy to .env and fill in. docker compose reads this file automatically.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs and verifies session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start in production without it.
JWT_SECRET=

# MySQL connection string. The default points at the `db` service in
# docker-compose.yml; change it to use an external database.
DATABASE_URL=mysql://faceswap:faceswap@db:3306/faceswap

# ---------------------------------------------------------------------------
# Database container (docker-compose only; ignored with an external database)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=faceswap
MYSQL_USER=faceswap
MYSQL_PASSWORD=faceswap
MYSQL_ROOT_PASSWORD=rootpassword

# Host port the app is published on, and the interface it is published on.
# APP_BIND defaults to 127.0.0.1 so the app is reachable only from this machine.
# Set it to 0.0.0.0 only if you intend everyone on your network to reach it.
APP_PORT=3000
# APP_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# Face swap pipeline. Without these, /api/health reports the matching
# dependency as failing and job submission errors rather than half-working.
# ---------------------------------------------------------------------------

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# HMAC secret for Replicate callbacks. Webhook verification fails closed, so an
# unset secret means callbacks are rejected rather than trusted blindly.
REPLICATE_WEBHOOK_SECRET=

# Public URL Replicate calls back on. Must be the full URL of this app's
# receiver route, which is POST /api/webhooks/replicate:
#   https://your-host.example.com/api/webhooks/replicate
# Leave empty to rely on client polling alone. Callbacks are rejected unless
# REPLICATE_WEBHOOK_SECRET is also set.
WEBHOOK_URL=

# Optional: route Replicate calls through your own proxy. Unset uses
# api.replicate.com.
# REPLICATE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Background sweep for abandoned jobs. Without it, a job only advances when a
# client asks about it: if the output copy fails or a webhook is lost and
# nobody reopens the page, the job sits in `processing` while the upstream
# output URL expires. Needs DATABASE_URL and REPLICATE_API_TOKEN; it reports
# itself as off under `sweeper` in /api/health when either is missing.
# ---------------------------------------------------------------------------
# STALE_JOB_SWEEP_ENABLED=false   # set to "false" to turn the sweep off
# STALE_JOB_SWEEP_INTERVAL_MS=300000    # how often to sweep (default 5m)
# STALE_JOB_STALE_AFTER_MS=600000       # how quiet a job must be (default 10m)
# STALE_JOB_SWEEP_BATCH=10              # most jobs per sweep (default 10)

# S3-backed upload/download storage (presigned via the Forge API).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Authentication (OAuth)
# ---------------------------------------------------------------------------
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# Client bundle. Read by vite at BUILD time and compiled into the JavaScript,
# so these must be set before `pnpm build` / `docker build`. Setting them only
# at runtime has no effect.
# ---------------------------------------------------------------------------
VITE_APP_ID=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_OAUTH_PORTAL_URL=

# ---------------------------------------------------------------------------
# Optional: alternative face swap providers (not used by the default pipeline)
# ---------------------------------------------------------------------------
# AKOOL_API_KEY=
# MAGIC_HOUR_API_KEY=
